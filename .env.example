# Neon (use the pooled connection string)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Cloudinary dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# One-time seed of first Super Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Sister sites (optional; these are the defaults)
NEXT_PUBLIC_SRC_URL=https://www.umatsridsrc.com
NEXT_PUBLIC_SPORTS_URL=https://sports.umatsridsrc.com
NEXT_PUBLIC_RAILERS_URL=https://railers.umatsridsrc.com
